# Copy to .env.local (gitignored) and fill in. Never commit real credentials.
# The initial provider is imported on first server start, then stored encrypted in data/.
ATLAS_INITIAL_M3U_URL=
ATLAS_INITIAL_PROVIDER_NAME=Primary provider
# Server bind address. Use 0.0.0.0 to reach ATLAS from a TV on your LAN.
ATLAS_HOST=127.0.0.1
ATLAS_PORT=4870
