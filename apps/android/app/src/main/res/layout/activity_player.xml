<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true" />

    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="28dp"
        android:background="#B3161A22"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4F6F8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/banner_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3F4F6F8"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Online subtitles (OpenSubtitles via the ATLAS server). Shown with the player controls;
         the remote's Menu key opens it too. -->
    <TextView
        android:id="@+id/subs_online"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:background="@drawable/pill_button"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="22dp"
        android:paddingTop="11dp"
        android:paddingEnd="22dp"
        android:paddingBottom="11dp"
        android:text="@string/find_subtitles"
        android:textColor="@color/pill_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#E6161A22"
        android:gravity="center"
        android:maxWidth="520dp"
        android:padding="24dp"
        android:textColor="#FFF4F6F8"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
