<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS (e.g. Render) is used when available. Plain HTTP is allowed so an ATLAS server on
     your home network (http://192.168.x.x:4870) works too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
